<% if (sucess && sucess.length) { %>
<div class="alert alert-success alert-dismissible col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3" role="alert">
  <%= sucess.join(", ") %>
  <button
    type="button"
    class="btn-close ms-auto"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %>

<% if (error && error.length) { %>
<div class="alert alert-danger alert-dismissible col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3" role="alert">
  <%= error.join(", ") %>
  <button
    type="button"
    class="btn-close ms-auto"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %>
